<?xml version="1.0"?>
<robot name="b2_one_leg">
  <!-- base link (невидимая опора) -->
  <link name="base">
    <inertial><mass value="1.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    <visual><geometry><box size="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.001 0.001 0.001"/></geometry></collision>
  </link>

  <!-- trunk с мешем -->
  <link name="trunk">
    <inertial>
      <mass value="35.606"/>
      <inertia ixx="0.27466" ixy="-0.000622" ixz="-0.00315" iyy="1.0618" iyz="-0.00139" izz="1.1825"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="/home/ager/delivery_dog_ws/install/b2_description/share/b2_description/meshes/trunk.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <geometry><box size="0.5 0.28 0.15"/></geometry> <!-- коллизия остаётся боксом -->
    </collision>
  </link>


  <joint name="floating_base" type="fixed">
    <origin xyz="0 0 0.5" rpy="0 0 0"/>   <!-- подняли на 0.2 м -->
    <parent link="base"/><child link="trunk"/>
  </joint>

  <!-- FL hip -->
  <link name="FL_hip">
    <inertial><mass value="2.256"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
    <visual>
    <geometry>
      <mesh filename="/home/ager/delivery_dog_ws/install/b2_description/share/b2_description/meshes/hip.dae" scale="1 1 1"/>
    </geometry>
  </visual>
  <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
  </link>

  <joint name="FL_hip_joint" type="revolute">
    <origin xyz="0.3285 0.072 0" rpy="0 0 0"/>
    <parent link="trunk"/><child link="FL_hip"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.87" upper="0.87" effort="200" velocity="23"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- FL thigh -->
  <link name="FL_thigh">
    <inertial><mass value="3.591"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.01"/></inertial>
    <visual>
    <geometry>
      <mesh filename="/home/ager/delivery_dog_ws/install/b2_description/share/b2_description/meshes/thigh.dae" scale="1 1 1"/>
    </geometry>
  </visual>
  <collision><geometry><box size="0.32 0.0455 0.054"/></geometry></collision>
  </link>

  <joint name="FL_thigh_joint" type="revolute">
    <origin xyz="0 0.11973 0" rpy="0 0 0"/>
    <parent link="FL_hip"/><child link="FL_thigh"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.94" upper="4.69" effort="200" velocity="23"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- FL calf -->
  <link name="FL_calf">
    <inertial><mass value="0.58094"/><inertia ixx="0.011" ixy="0" ixz="0" iyy="0.011" iyz="0" izz="0.0003"/></inertial>
    <visual><origin rpy="0 1.57 0" xyz="0 0 0"/>
    <!-- <geometry><box size="0.35 0.0245 0.018"/></geometry> -->
    <geometry>
      <mesh filename="/home/ager/delivery_dog_ws/install/b2_description/share/b2_description/meshes/calf.dae" scale="1 1 1"/>
    </geometry>
    </visual>
    <collision><origin rpy="0 1.57 0" xyz="0 0 0"/>
    <geometry><box size="0.35 0.0245 0.018"/></geometry></collision>
  </link>

  <joint name="FL_calf_joint" type="revolute">
    <origin xyz="0 0 -0.32" rpy="0 0 0"/>
    <parent link="FL_thigh"/><child link="FL_calf"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.82" upper="-0.43" effort="320" velocity="14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- FL foot -->
  <link name="FL_foot">
    <inertial><mass value="0.098"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><sphere radius="0.032"/></geometry></visual>
    <collision><geometry><sphere radius="0.032"/></geometry></collision>
  </link>

  <joint name="FL_foot_joint" type="fixed">
    <origin xyz="0 0 -0.35" rpy="1.57 0 0"/>
    <parent link="FL_calf"/><child link="FL_foot"/>
  </joint>

  <!-- ROS2 CONTROL -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="FL_hip_joint">
      <command_interface name="effort"><param name="min">-200</param><param name="max">200</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/>
      <param name="initial_position">0.0</param>
    </joint>
    <joint name="FL_thigh_joint">
      <command_interface name="effort"><param name="min">-200</param><param name="max">200</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/>
      <param name="initial_position">0.0</param>
    </joint>
    <joint name="FL_calf_joint">
      <command_interface name="effort"><param name="min">-320</param><param name="max">320</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/>
      <param name="initial_position">-0.5</param>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
      <parameters>/home/ager/delivery_dog_ws/install/b2_description/share/b2_description/config/robot_control.yaml</parameters>
      <ros><arg name="use_sim_time" value="true"/></ros>
    </plugin>
  </gazebo>
</robot>