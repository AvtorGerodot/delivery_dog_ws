<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Подключение ros2_control -->
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
        <!-- <parameters>$(find b2_description)/config/robot_control.yaml</parameters> -->
        <parameters>/home/ager/delivery_dog_ws/install/b2_description/share/b2_description/config/robot_control.yaml</parameters>
        <ros>
            <arg name="use_sim_time" value="true"/>
        </ros>
    </plugin>
  </gazebo>



  <!-- IMU через обычный сенсор и мост (упрощённо) -->
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <topic>imu_data</topic>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    </sensor>
  </gazebo>
    

  <!-- Контактные сенсоры для стоп (без кастомного плагина) -->
