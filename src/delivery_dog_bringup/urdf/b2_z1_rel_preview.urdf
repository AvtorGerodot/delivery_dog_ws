      <inertia ixx="0.00038683" ixy="-3.59e-06" ixz="7.662e-05" iyy="0.00068614" iyz="2.09e-06" izz="0.00066293"/>
    </inertial>
  </link>
  <!-- Нажимной элемент (Finger) -->
  <link name="z1_Gripper_finger">
    <inertial>
      <origin rpy="0 0 0" xyz="0.117494 0.0 -0.040887"/>
      <mass value="0.003286"/>
      <inertia ixx="0.0000000259" ixy="0.0" ixz="-0.0000000568" iyy="0.000001303" iyz="0.0" izz="0.000001293"/>
    </inertial>
    <visual>
      <!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->
      <origin rpy="0 1.5708 0" xyz="0.139 0 -0.042"/>
      <geometry>
        <!-- <mesh filename="$(find z1_model)/meshes/visual/stl_models/z1_Gripper_finger.stl" scale="1 1 1"/> -->
        <cylinder length="0.036" radius="0.003"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->
      <origin rpy="0 1.5708 0" xyz="0.139 0 -0.042"/>
      <geometry>
        <!-- Рекомендуется использовать упрощенную геометрию для коллизий, но можно и stl -->
        <!-- <mesh filename="$(find z1_model)/meshes/visual/z1_Gripper_finger.stl" scale="1 1 1"/> -->
        <cylinder length="0.036" radius="0.003"/>
      </geometry>
    </collision>
  </link>
  <!-- Крепление нажимного элемента к статору схвата -->
  <joint name="gripper_stator_to_finger" type="fixed">
    <parent link="z1_gripperStator"/>
    <!-- Замените на точное имя link'а вашего статора -->
    <child link="z1_Gripper_finger"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <!-- Позиции совпадают, как вы указали -->
  </joint>
  <!-- TCP на кончике нажимного элемента -->
  <!-- Пустой линк без массы и визуализации -->
  <link name="z1_finger_tcp_link"/>
  <!-- </link> -->
  <joint name="finger_to_finger_tcp" type="fixed">
    <parent link="z1_Gripper_finger"/>
    <child link="z1_finger_tcp_link"/>
    <!-- Сдвигаем точку ровно туда, где находится край визуального цилиндра -->
    <!-- Цилиндр имеет длину 0.036 и сдвинут на 0.139. 
            Eго край находится на: 0.139 + (0.036/2) = 0.157 -->
    <origin rpy="0 1.5708 0" xyz="0.157 0 -0.042"/>
  </joint>
  <!-- подвижная часть схвата -->
  <joint name="z1_jointGripper" type="revolute">
    <origin rpy="0 0 0" xyz="0.049 0.0 0"/>
    <parent link="z1_gripperStator"/>
    <child link="z1_gripperMover"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1.0" friction="1.0"/>
    <limit effort="30.0" lower="-1.5707963267948966" upper="0.0" velocity="3.1415"/>
  </joint>
