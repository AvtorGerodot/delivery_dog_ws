         Origin xyz передаётся как параметр макроса. -->
  <joint name="button_1_joint" type="prismatic">
    <parent link="intercom_body"/>
    <child link="button_1"/>
    <origin rpy="0 0 0" xyz="0.01 -0.018  0.013"/>
    <axis xyz="-1 0 0"/>
    <limit effort="20" lower="0" upper="0.003" velocity="0.1"/>
    <dynamics damping="3.0" friction="0.1"/>
  </joint>
  <!-- SDF-расширение: пружинный возврат + упор хода. -->
