      <inertia ixx="9.20" ixy="0" ixz="0" iyy="0.083" iyz="0" izz="9.20"/>
    </inertial>
  </link>
  <joint name="door_hinge" type="revolute">
    <parent link="floor"/>
    <child link="door"/>
    <origin rpy="0 0 0" xyz="0.1 0.45 1.05"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="0" upper="1.57" velocity="2.0"/>
    <dynamics damping="3.0" friction="1.5"/>
  </joint>
  <!-- Пружина-доводчик двери -->
